{
    "name": "kareemsliet/chat",
    "description": "Chat Package for Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "chat",
        "chatting",
        "groups",
        "messages",
        "conversations"
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14|^1.23",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "license": "MIT",
    "homepage": "https://github.com/Kareemsliet/chat",
    "support": {
        "issues": "https://github.com/Kareemsliet/chat/issues",
        "source": "https://github.com/Kareemsliet/chat"
    },
    "authors": [
        {
            "name": "kareem sliet",
            "email": "kareemoii37@gmail.com",
            "role": "BackEnd Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "kareemsliet\\Chat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "kareemsliet\\Chat\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "kareemsliet\\Chat\\ChatServiceProvider"
            ],
            "aliases": {
                "Chat": "kareemsliet\\Chat\\Facades\\Chat"
            }
        }
    },
     "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev"
}